{
  "name": "wp-mcp-server",
  "version": "0.1.0",
  "description": "MCP server that lets an AI design agent connect to any WordPress site, read its real rendered CSS/JS/theme info, and create/update pages.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wp-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke-test": "tsx scripts/smoke-test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wordpress",
    "fusion-builder",
    "avada"
  ],
  "author": "gentleman-programming",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eimon/wp-mcp.git"
  },
  "homepage": "https://github.com/eimon/wp-mcp#readme",
  "bugs": {
    "url": "https://github.com/eimon/wp-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0"
  },
  "license": "MIT"
}
